{
  "name": "senu",
  "version": "0.1.0",
  "description": "Modular TypeScript utilities for data structures, bytes, objects, async work, results, validation, retries, caching, and state, with no runtime dependencies.",
  "license": "MIT",
  "author": "arnonsang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnonsang/senu.git"
  },
  "homepage": "https://github.com/arnonsang/senu#readme",
  "bugs": {
    "url": "https://github.com/arnonsang/senu/issues"
  },
  "keywords": [
    "typescript",
    "esm",
    "deque",
    "result",
    "standard-schema",
    "retry",
    "cache",
    "lru",
    "singleflight",
    "abort-signal",
    "base64",
    "clone"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./struct": {
      "types": "./dist/struct/index.d.ts",
      "default": "./dist/struct/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "default": "./dist/object/index.js"
    },
    "./bytes": {
      "types": "./dist/bytes/index.d.ts",
      "default": "./dist/bytes/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "default": "./dist/async/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "default": "./dist/result/index.js"
    },
    "./boundary": {
      "types": "./dist/boundary/index.d.ts",
      "default": "./dist/boundary/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "default": "./dist/resilience/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "default": "./dist/state/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/runtime/**/*.test.ts\"",
    "test:coverage": "node scripts/coverage.mjs",
    "check": "npm run typecheck && npm run test:coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "arktype": "2.2.9",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  }
}
